# DashScope API 配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-max

# NoneBot 配置
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 机器人配置
SUPERUSERS=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]

# 知识库路径（相对于 magic 项目根目录）
WIKI_PATH=../wiki
RAW_PATH=../raw
SKILL_PATH=../skill
AGENT_PATH=../agent
