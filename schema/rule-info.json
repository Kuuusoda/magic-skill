{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleInfo",
  "type": "object",
  "required": ["keyword", "matches"],
  "properties": {
    "keyword": { "type": "string" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_number", "rule_text", "source_file", "source_type"],
        "properties": {
          "rule_number": { "type": "string" },
          "rule_text": { "type": "string" },
          "source_file": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["wiki_concept", "wiki_decision_tree", "wiki_framework", "cr_rule", "mtr_rule", "ipg_rule"]
          }
        }
      }
    }
  }
}
